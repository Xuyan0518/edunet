# Required
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
JWT_SECRET=<strong-random-secret>
# Authentication emails (verify this sending domain in Resend before use)
AUTH_MAIL_MODE=resend
RESEND_API_KEY=
AUTH_EMAIL_FROM=EduNet <no-reply@your-verified-domain.example>
AUTH_MAIL_ENABLED=true
# Optional: a separate stable encryption key of at least 32 random characters.
# Without it, pending authentication emails are encrypted using JWT_SECRET.
AUTH_MAIL_ENCRYPTION_KEY=
WECHAT_APP_ID=wx5bc50d354c4feb10
WECHAT_APP_SECRET=...

# Optional
REVIEWER_LOGIN_ENABLED=false
# If reviewer access is intentionally enabled, configure a dedicated demo student
# and explicit REVIEWER_USERNAME / REVIEWER_PASSWORD (at least 16 characters).
CORS_ORIGIN=https://your-app.example
NODE_ENV=production
SERVE_WEB=true
# Render supplies PORT automatically. Leave API_PORT unset on Render.
DEPLOYMENT_ENV=production
# Private staging only: use DEPLOYMENT_ENV=staging with a separate database,
# signing key and access password (at least 24 random characters).
STAGING_ACCESS_USERNAME=
STAGING_ACCESS_PASSWORD=
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
WECHAT_DAILY_TEMPLATE_ID=
WECHAT_WEEKLY_TEMPLATE_ID=
WECHAT_EXAM_TEMPLATE_ID=
WECHAT_SEMESTER_TEMPLATE_ID=
WECHAT_YEARLY_TEMPLATE_ID=

# Browser sign-in (website WeChat credentials are separate from mini-program credentials)
API_PUBLIC_URL=https://your-app.example
WEB_APP_URL=https://your-app.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
