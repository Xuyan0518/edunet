# Required
DATABASE_URL=postgresql://<user>:***@<host>/<db>?sslmode=require
# Keep certificate verification enabled. Set false only for a documented provider-specific CA exception.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional: set to disable only for a trusted private-network database URL.
DATABASE_SSL_MODE=
JWT_SECRET=<strong-random-secret>
WECHAT_APP_ID=wx5bc50d354c4feb10
WECHAT_APP_SECRET=...
GOOGLE_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=<same-web-client-id>.apps.googleusercontent.com
CORS_ORIGIN=https://<your-web-host>
FRONTEND_URL=https://<your-web-host>
DEEPSEEK_API_KEY=<deepseek-api-key>

# Optional
NODE_ENV=production
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
WECHAT_DAILY_TEMPLATE_ID=
WECHAT_WEEKLY_TEMPLATE_ID=
WECHAT_EXAM_TEMPLATE_ID=
WECHAT_SEMESTER_TEMPLATE_ID=
WECHAT_YEARLY_TEMPLATE_ID=
